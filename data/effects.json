    "channels": ["scale", "alpha", "offsetX", "offsetY", "rotate", "tint", "aura", "trail", "outline"],
    "operations": {
      "scale": "multiply",
      "alpha": "multiply",
      "offsetX": "add",
      "offsetY": "add",
      "rotate": "add",
      "tint": "last",
      "aura": "append",
      "trail": "append",
      "outline": "last",
      "stepDurationScale": "multiply",
      "coinBonus": "add"
    },
    "defaults": {
      "scale": 1,
      "alpha": 1,
      "offsetX": 0,
      "offsetY": 0,
      "rotate": 0,
      "tint": null,
      "aura": [],
      "trail": [],
      "outline": null,
      "stepDurationScale": 1,
      "coinBonus": 0
    },
    "entryOrder": ["self", "party"],
    "note": "Own gear applies first, then party gear inherited from the owner. Scale, alpha and stepDurationScale multiply; offsetX/Y, rotate and coinBonus add; tint and outline use the last non-null value; aura and trail append in entry order."
  },
  "transitions": {
    "defaults": {
      "equipMs": 220,
      "unequipMs": 180,
      "easing": "ease-out"
    }
